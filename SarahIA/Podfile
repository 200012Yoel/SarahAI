# Sarah IA — dépendances CocoaPods
# Installation sur le Mac : `cd SarahIA && pod install`, puis ouvrir SarahIA.xcworkspace.

platform :ios, '16.2'

target 'SarahIA' do
  use_frameworks!

  # Pack hors ligne de Google Traduction (hébreu ⇄ français sans Internet)
  pod 'GoogleMLKit/Translate', '8.0.0'
end

# Xcode 15+ bloque par défaut les scripts de CocoaPods (copie des frameworks Google
# dans l'app). On autorise ces scripts pour la cible Sarah IA et les Pods.
post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.2'
    end
  end
  installer.aggregate_targets.each do |aggregate|
    aggregate.user_project.native_targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'
      end
    end
    aggregate.user_project.save
  end
end
